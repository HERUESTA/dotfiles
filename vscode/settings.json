// VSCode のユーザー設定
//
// このファイルが実体。VSCode 側からはシンボリックリンクで参照する。
// 新しいマシンでのセットアップ:
//
//   ln -s ~/dotfiles/vscode/settings.json \
//     "$HOME/Library/Application Support/Code/User/settings.json"
//
// 既にファイルがある場合は先に退避する:
//
//   mv "$HOME/Library/Application Support/Code/User/settings.json" \
//     "$HOME/Library/Application Support/Code/User/settings.json.bak"
{
    "terminal.integrated.enableImages": true,
    "files.autoSave": "afterDelay",
    "editor.fontSize": 16,
    "typescript.inlayHints.parameterNames.enabled": "all",
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "claudeCode.preferredLocation": "panel",
    "editor.tabSize": 2,
    "editor.stickyTabStops": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "github.copilot.nextEditSuggestions.enabled": false,
    "[ruby]": {
        "editor.defaultFormatter": "misogi.ruby-rubocop"
    },
    "rubyLsp.rubyVersionManager": {
        "identifier": "rbenv"
    },
    "rubyLsp.bundleGemfile": "/Users/shunya/.ruby-lsp/Gemfile",
    "rubyLsp.useBundlerCompose": false,
    "workbench.colorTheme": "GitHub Dark Colorblind (Beta)",
    "chat.viewSessions.orientation": "stacked",
    "extensions.autoUpdate": "off",
    "workbench.settings.applyToAllProfiles": [

    ],

    // gitmoji（種別と絵文字の対応は lazygit/config.yml と揃える）
    // 拡張機能は emoji の値をそのまま挿入し、後ろに半角スペースを 1 つ付ける。例: "📝docs: "
    "gitmoji.outputType": "emoji",      // emoji の値（絵文字 + 種別）を出力する
    "gitmoji.onlyUseCustomEmoji": true, // カスタマイズした絵文字のみ表示する
    "gitmoji.addCustomEmoji": [         // 絵文字のカスタマイズ
        {
